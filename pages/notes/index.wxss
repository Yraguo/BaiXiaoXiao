.notes-head { display: flex; align-items: flex-start; justify-content: space-between; }
/* 用 view + 锁定尺寸：button 在 flex 里会被拉宽，这个坑本项目踩过两次 */
.add-note { width: 76rpx; min-width: 76rpx; max-width: 76rpx; height: 76rpx; margin: 4rpx 0 0; border-radius: 22rpx; background: #fff; color: var(--brand); font-size: 44rpx; line-height: 72rpx; text-align: center; }
.add-note:active { background: #eef2f7; }

.calendar { margin-top: 6rpx; padding: 18rpx 12rpx 10rpx; border-radius: 26rpx; background: #fff; box-shadow: 0 6rpx 24rpx rgba(38, 57, 88, .05); }
.calendar-head { display: flex; align-items: center; justify-content: space-between; padding: 2rpx 4rpx 14rpx; }
.month-nav { width: 64rpx; height: 64rpx; border-radius: 18rpx; background: var(--brand-light); color: var(--brand); font-size: 38rpx; line-height: 60rpx; text-align: center; }
.month-nav:active { opacity: .65; }
.month-title { display: flex; align-items: baseline; gap: 12rpx; font-size: 34rpx; font-weight: 700; }
.month-meta { color: var(--muted); font-size: 21rpx; font-weight: 400; }

.weekdays { display: flex; padding: 4rpx 0 6rpx; }
.weekday { flex: 1; color: var(--muted); font-size: 20rpx; text-align: center; }

.grid { display: flex; flex-wrap: wrap; }
.cell { box-sizing: border-box; display: flex; flex-direction: column; align-items: center; justify-content: center; width: 14.2857%; height: 94rpx; border-radius: 18rpx; }
.cell.dim .day-number { color: #c7c7cc; }
.day-number { font-size: 30rpx; line-height: 1.1; }
.dot { width: 8rpx; height: 8rpx; margin-top: 8rpx; border-radius: 50%; background: transparent; }
.dot.show { background: var(--brand); }
.cell.today .day-number { color: var(--brand); font-weight: 700; }
.cell.selected { background: var(--brand); }
.cell.selected .day-number { color: #fff; font-weight: 700; }
.cell.selected .dot.show { background: #fff; }

.day-head { display: flex; align-items: center; justify-content: space-between; padding: 26rpx 10rpx 12rpx; }
.day-title { font-size: 27rpx; font-weight: 600; }
.day-action { color: var(--brand); font-size: 22rpx; }

.note-row { display: flex; align-items: center; min-height: 126rpx; padding: 18rpx 22rpx; border-bottom: 1rpx solid var(--line); }
.note-row:last-child { border-bottom: 0; }
.check { width: 42rpx; height: 42rpx; flex: none; border: 3rpx solid var(--brand); border-radius: 50%; color: #fff; background: #fff; font-size: 24rpx; line-height: 38rpx; text-align: center; }
.done .check { background: var(--brand); }
.note-main { flex: 1; min-width: 0; padding: 0 18rpx; }
.note-title { overflow: hidden; font-size: 29rpx; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
.done .note-title { color: var(--muted); text-decoration: line-through; }
.note-copy { margin-top: 6rpx; overflow: hidden; color: var(--muted); font-size: 23rpx; text-overflow: ellipsis; white-space: nowrap; }
.note-time { margin-top: 6rpx; color: var(--brand); font-size: 21rpx; }
.remove { flex: none; padding: 18rpx 4rpx; color: var(--danger); font-size: 23rpx; }

.empty { padding: 54rpx 30rpx 62rpx; color: var(--muted); text-align: center; }
.empty-owl { display: block; width: 170rpx; height: 170rpx; margin: 0 auto 10rpx; }
.empty-copy { margin-top: 10rpx; font-size: 22rpx; }

.add-bar { margin: 22rpx 4rpx 0; padding: 22rpx; border: 1rpx dashed rgba(0, 122, 255, .38); border-radius: 20rpx; background: rgba(0, 122, 255, .05); color: var(--brand); font-size: 24rpx; text-align: center; }
.add-bar:active { background: rgba(0, 122, 255, .12); }
