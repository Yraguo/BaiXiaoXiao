.form-card { margin-top: 16rpx; overflow: hidden; }
.field {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 22rpx;
  border-bottom: 1rpx solid var(--line);
}
.field-last { align-items: flex-start; border-bottom: 0; }
.field-label { width: 130rpx; flex: none; color: var(--muted); font-size: 24rpx; }
.field-input { flex: 1; min-width: 0; font-size: 27rpx; }
.field-picker { display: flex; flex: 1; align-items: center; justify-content: space-between; font-size: 27rpx; }
.field-textarea { flex: 1; min-width: 0; height: 120rpx; font-size: 26rpx; line-height: 1.5; }

.form-save { margin-top: 28rpx; }
.form-delete { margin-top: 16rpx; }
.form-tip { margin: 24rpx 12rpx 0; color: #9aa2af; font-size: 20rpx; line-height: 1.7; }

.field-block { align-items: flex-start; flex-direction: column; gap: 14rpx; }
.field-block .field-label { width: auto; }
.field-hint { color: #b3bac5; font-size: 20rpx; }
.plate-block { padding: 24rpx 22rpx; }
.plate-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12rpx; width: 100%; }
.plate-tile {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 18rpx 14rpx;
  border-radius: 16rpx;
  background: #f4f6fa;
  color: var(--text);
  font-size: 22rpx;
  line-height: 1.25;
}
.plate-tile.active { background: var(--brand); color: #fff; box-shadow: 0 6rpx 16rpx rgba(0, 122, 255, .28); }
.plate-key { flex: none; font-size: 24rpx; font-weight: 700; }
.plate-name { flex: 1; min-width: 0; }
.score-chips { display: flex; flex-wrap: wrap; gap: 10rpx; }
.score-chip { padding: 12rpx 22rpx; border-radius: 14rpx; background: #f4f6fa; color: var(--muted); font-size: 22rpx; }
.score-chip.active { background: var(--brand-light); color: var(--brand); font-weight: 600; }
.score-input { width: 100%; }
.photo-grid { display: flex; flex-wrap: wrap; gap: 14rpx; }
.photo-item { position: relative; width: 150rpx; height: 150rpx; }
.photo-img { width: 150rpx; height: 150rpx; border-radius: 14rpx; }
.photo-remove { position: absolute; top: -8rpx; right: -8rpx; width: 36rpx; height: 36rpx; border-radius: 50%; background: rgba(0,0,0,.55); color: #fff; font-size: 24rpx; line-height: 34rpx; text-align: center; }
.photo-add { display: flex; width: 150rpx; height: 150rpx; align-items: center; justify-content: center; border: 1rpx dashed rgba(0,122,255,.4); border-radius: 14rpx; background: rgba(0,122,255,.04); color: var(--brand); font-size: 44rpx; }

.wm-canvas { position: fixed; left: -9999rpx; top: 0; width: 300rpx; height: 300rpx; }

.hour-chips { display: flex; flex-wrap: wrap; gap: 10rpx; }
.hour-chip { padding: 12rpx 20rpx; border-radius: 14rpx; background: #f4f6fa; color: var(--muted); font-size: 22rpx; }
.hour-chip.active { background: var(--brand-light); color: var(--brand); font-weight: 600; }

.photo-actions { display: flex; align-items: center; gap: 12rpx; }
.photo-btn {
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  background: var(--brand-light);
  color: var(--brand);
  font-size: 22rpx;
  font-weight: 600;
}
.photo-btn:active { background: rgba(0, 122, 255, .18); }
.photo-count { margin-left: auto; color: #b3bac5; font-size: 20rpx; }


/* 数字输入：和快捷值并排，不再是一个光秃秃的 0 */
.num-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  align-self: flex-start;
  margin-top: 2rpx;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #f4f6fa;
}
.num-label { color: var(--muted); font-size: 21rpx; }
.num-input { width: 90rpx; color: var(--text); font-size: 24rpx; font-weight: 600; text-align: right; }
.num-unit { color: var(--muted); font-size: 21rpx; }

/* 位置：一行就够，点开是微信地图选点 */
.place-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 22rpx;
}
.place-main { flex: 1; min-width: 0; }
.place-name {
  overflow: hidden;
  color: var(--text);
  font-size: 27rpx;
  font-weight: 500;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.place-name.is-empty { color: #b3bac5; font-weight: 400; }
.place-sub { margin-top: 6rpx; color: #b3bac5; font-size: 20rpx; }
.place-clear { flex: none; padding: 8rpx 6rpx; color: var(--muted); font-size: 22rpx; }
