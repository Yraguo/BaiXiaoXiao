.form-card { margin-top: 16rpx; overflow: hidden; }
.field {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 22rpx;
  border-bottom: 1rpx solid var(--line);
}
.field-last { align-items: flex-start; border-bottom: 0; }
.field-label { width: 130rpx; flex: none; color: var(--muted); font-size: 24rpx; }
.field-input { flex: 1; min-width: 0; font-size: 27rpx; }
.field-picker { display: flex; flex: 1; align-items: center; justify-content: space-between; font-size: 27rpx; }
.field-textarea { flex: 1; min-width: 0; height: 120rpx; font-size: 26rpx; line-height: 1.5; }

.form-save { margin-top: 28rpx; }
.form-delete { margin-top: 16rpx; }
.form-tip { margin: 24rpx 12rpx 0; color: #9aa2af; font-size: 20rpx; line-height: 1.7; }
