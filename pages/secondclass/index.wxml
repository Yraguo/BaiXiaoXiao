<view class="page-shell">
  <view class="sc-head">
    <view class="sc-title">第二课堂</view>
    <view class="sc-sub">{{headLine}}</view>
  </view>

  <view class="sc-seg">
    <view class="sc-seg-item {{tab === 'score' ? 'active' : ''}}" data-tab="score" bindtap="switchTab">二课填报</view>
    <view class="sc-seg-item {{tab === 'volunteer' ? 'active' : ''}}" data-tab="volunteer" bindtap="switchTab">志愿时长</view>
    <view class="sc-seg-item {{tab === 'labor' ? 'active' : ''}}" data-tab="labor" bindtap="switchTab">劳育时长</view>
  </view>

  <!-- 二课填报 -->
  <block wx:if="{{tab === 'score'}}">
    <view class="sc-summary">
      <view class="sc-total">
        <text class="sc-total-num">{{totalText}}</text>
        <text class="sc-total-cap">/ {{full}}</text>
      </view>
      <view class="sc-total-label">合计自评</view>
      <view class="sc-bars">
        <view wx:for="{{plates}}" wx:key="key" class="sc-bar-row">
          <text class="sc-bar-name" style="color:{{item.color}}">{{item.short}}</text>
          <view class="sc-bar-track">
            <view class="sc-bar-fill" style="width:{{item.percent}}%;background:{{item.color}}"></view>
          </view>
          <text class="sc-bar-value">{{item.scoreText}}/{{item.full}}</text>
        </view>
      </view>
    </view>

    <view class="sc-link" bindtap="openManual">📋 手册分值表（板块上限 / 学科 / 体育 / 美育 / 计分条款）</view>

    <view class="sc-export" bindtap="openExport" aria-role="button">
      <view class="sc-export-ico">📦</view>
      <view class="sc-export-main">
        <view class="sc-export-title">导出二课材料</view>
        <view class="sc-export-copy">清单长图 · {{photoCount}} 张照片</view>
      </view>
      <text class="chevron">›</text>
    </view>

    <scroll-view class="sc-filters" scroll-x>
      <view
        wx:for="{{filters}}"
        wx:key="key"
        class="sc-chip {{item.active ? 'active' : ''}}"
        data-key="{{item.key}}"
        bindtap="changeFilter"
      >{{item.key === 'all' ? '全部' : item.short + '·' + item.name}}</view>
    </scroll-view>

    <view wx:if="{{!records.length}}" class="sc-empty">
      <image class="sc-empty-owl" src="/assets/owl/owl-study.png" mode="aspectFit"></image>
      <view class="sc-empty-title">还没有自评记录</view>
      <view class="sc-empty-copy">点右下角「填报活动」开始记第一条</view>
    </view>

    <view wx:else class="sc-list">
      <view wx:for="{{records}}" wx:key="id" class="sc-item" data-id="{{item.id}}" bindtap="openRecord">
        <view class="sc-badge" style="background:{{item.tint}};color:{{item.color}}">{{item.plateShort}}</view>
        <view class="sc-item-main">
          <view class="sc-item-title">{{item.title}}</view>
          <view class="sc-item-meta">{{item.dateText}} · {{item.levelText}}{{item.hoursText ? ' · ' + item.hoursText : ''}} · {{item.photoText}}{{item.watermark ? ' · 水印' : ''}}</view>
        </view>
        <text class="sc-item-score" style="color:{{item.color}}">+{{item.scoreText}}</text>
      </view>
    </view>

    <view class="sc-tip">分数为自行填报与自评，上限依据《北京化工大学本科生学生手册·学生事务管理制度》。最终认定以学校审核为准。</view>
  </block>

  <!-- 志愿 / 劳育时长 -->
  <!-- 这里必须用 wx:if 显式判断，不能靠 wx:else：
       wx:else 要求紧跟上一个兄弟节点，中间隔一行注释就可能失效，
       表现就是切到这两个页签后整块内容不渲染 -->
  <block wx:if="{{tab !== 'score'}}">
    <view class="sc-hours">
      <view class="sc-hours-top">
        <view>
          <text class="sc-hours-num">{{tab === 'volunteer' ? volunteer.totalText : labor.totalText}}</text>
          <text class="sc-hours-unit">小时</text>
        </view>
        <view class="sc-hours-side">
          <view>今年 {{tab === 'volunteer' ? volunteer.yearText : labor.yearText}} 小时 · 共 {{tab === 'volunteer' ? volunteer.yearCount : labor.yearCount}} 条</view>
          <view class="sc-hours-note">与第二课堂自评分是两套独立口径</view>
        </view>
      </view>
      <view class="sc-hours-label">累计{{tab === 'volunteer' ? '志愿' : '劳育'}}时长（小时）</view>
    </view>

    <view class="sc-add-hour" data-kind="{{tab}}" bindtap="openHour">＋ 记一条{{tab === 'volunteer' ? '志愿' : '劳育'}}时长</view>

    <view wx:for="{{tab === 'volunteer' ? volunteer.groups : labor.groups}}" wx:key="term" class="sc-term">
      <view class="sc-term-head">
        <text class="sc-term-name">{{item.term}}</text>
        <text class="sc-term-hours">{{item.hoursText}} 小时</text>
      </view>
      <view wx:if="{{item.empty}}" class="sc-term-empty">还没有记录</view>
      <view wx:else>
        <view wx:for="{{item.records}}" wx:for-item="record" wx:key="id" class="sc-term-row">
          <view class="sc-term-row-main">
            <view>{{record.title}}</view>
            <view class="sc-term-row-meta">{{record.date}}{{record.note ? ' · ' + record.note : ''}}</view>
          </view>
          <text class="sc-term-row-hours">{{record.hours}} h</text>
        </view>
      </view>
    </view>
  </block>

  <view wx:if="{{tab === 'score'}}" class="sc-fab" bindtap="addRecord">填报活动</view>
</view>

<!-- 手册分值表 -->
<view wx:if="{{manualOpen}}" class="mask" bindtap="closeManual">
  <view class="sc-sheet manual" catchtap="noop">
    <view class="manual-head">
      <view class="manual-head-text">
        <view class="manual-title">第二课堂 · 手册分值表</view>
        <view class="manual-src">《北京化工大学本科生学生手册·学生事务管理制度》。仅供参考，最终认定以学校审核为准。</view>
      </view>
      <view class="manual-close" bindtap="closeManual">关闭</view>
    </view>

    <scroll-view class="manual-tabs" scroll-x>
      <view
        wx:for="{{manualTabs}}"
        wx:key="key"
        class="manual-tab {{manualTab === item.key ? 'active' : ''}}"
        data-key="{{item.key}}"
        bindtap="changeManualTab"
      >{{item.name}}</view>
    </scroll-view>

    <scroll-view class="manual-body" scroll-y>
      <block wx:if="{{manualTab === 'caps'}}">
        <view class="mt-row mt-head">
          <text class="mt-c1">板块</text><text class="mt-c2">评定名称</text>
          <text class="mt-c3">满分</text><text class="mt-c3">基础</text><text class="mt-c3">拓展</text>
        </view>
        <view wx:for="{{caps}}" wx:key="key" class="mt-row">
          <text class="mt-c1">{{item.short}}</text>
          <text class="mt-c2">{{item.name}}</text>
          <text class="mt-c3">{{item.full}}</text>
          <text class="mt-c3">{{item.base}}</text>
          <text class="mt-c3">{{item.extra}}</text>
        </view>
        <view class="mt-note">五板块合计满分 {{full}} 分，高于满分时按满分计算。</view>
      </block>

      <block wx:elif="{{manualTab === 'clause'}}">
        <input class="manual-search" value="{{clauseKeyword}}" placeholder="搜索关键词，如 志愿 / 打卡 / 宿舍" bindinput="onClauseSearch" />
        <view wx:for="{{clauses}}" wx:key="text" class="clause-row">
          <text class="clause-plate">{{item.plate === 'de' ? '德' : item.plate === 'zhi' ? '智' : item.plate === 'ti' ? '体' : item.plate === 'mei' ? '美' : '劳'}}</text>
          <text class="clause-text">{{item.text}}</text>
        </view>
        <view wx:if="{{!clauses.length}}" class="mt-note">没有匹配的条款</view>
      </block>

      <block wx:else>
        <view class="mt-table-title">{{manualTab === 'contest' ? contest.title : manualTab === 'sport' ? sport.title : art.title}}</view>
        <scroll-view class="mt-scroll" scroll-x>
          <view>
            <view class="mt-row mt-head">
              <text class="mt-c0">获奖情况</text>
              <text wx:for="{{manualTab === 'contest' ? contest.columns : manualTab === 'sport' ? sport.columns : art.columns}}" wx:key="*this" class="mt-cell">{{item}}</text>
            </view>
            <view
              wx:for="{{manualTab === 'contest' ? contest.rows : manualTab === 'sport' ? sport.rows : art.rows}}"
              wx:key="label"
              class="mt-row"
            >
              <text class="mt-c0">{{item.label}}</text>
              <text wx:for="{{item.scores}}" wx:for-item="score" wx:key="*this" class="mt-cell">{{score}}</text>
            </view>
          </view>
        </scroll-view>
        <view class="mt-note">{{manualTab === 'contest' ? contest.note : manualTab === 'sport' ? sport.note : art.note}}</view>
      </block>
    </scroll-view>
  </view>
</view>

<!-- 记一条时长 -->
<view wx:if="{{hourOpen}}" class="mask" bindtap="closeHour">
  <view class="sc-sheet hour" catchtap="noop">
    <view class="hour-head">
      <view class="hour-title">记一条{{hourKind === 'volunteer' ? '志愿' : '劳育'}}时长</view>
      <view class="hour-cancel" bindtap="closeHour">取消</view>
    </view>

    <view class="hour-body">
      <view class="hour-label">学期</view>
      <view class="hour-terms">
        <view
          wx:for="{{terms}}"
          wx:key="*this"
          class="hour-term {{hourDraft.term === item ? 'active' : ''}}"
          data-term="{{item}}"
          bindtap="setHourTerm"
        >{{item}}</view>
      </view>

      <view class="hour-label">事项名称（必填）</view>
      <input class="hour-input" value="{{hourDraft.title}}" placeholder="如：社区志愿服务" data-field="title" bindinput="onHourInput" />

      <view class="hour-label">时长（小时，必填）</view>
      <view class="hour-chips">
        <view
          wx:for="{{hourChips}}"
          wx:key="*this"
          class="hour-chip {{hourDraft.hours == item ? 'active' : ''}}"
          data-hours="{{item}}"
          bindtap="setHourValue"
        >{{item}}</view>
      </view>
      <input class="hour-input" type="digit" value="{{hourDraft.hours}}" data-field="hours" bindinput="onHourInput" />

      <view class="hour-label">日期</view>
      <picker mode="date" value="{{hourDraft.date}}" bindchange="onHourDate">
        <view class="hour-input picker"><text>{{hourDraft.date || '选择日期'}}</text><text class="chevron">›</text></view>
      </picker>

      <view class="hour-label">备注（选填）</view>
      <input class="hour-input" value="{{hourDraft.note}}" placeholder="组织方、证明人等" data-field="note" bindinput="onHourInput" />
    </view>

    <view class="hour-save" bindtap="saveHour">保存</view>
  </view>
</view>

<!-- 导出二课材料 -->
<view wx:if="{{exportOpen}}" class="mask" bindtap="closeExport">
  <view class="sc-sheet export" catchtap="noop">
    <view class="export-head">
      <view class="export-title">导出二课材料</view>
      <view class="export-close" bindtap="closeExport">关闭</view>
    </view>
    <view class="export-note">小程序没有写手机文件的权限，能交给你的只有「相册」。存完可以在微信里直接发给老师，或上传到学校系统。</view>

    <view class="export-option" bindtap="saveSheet" aria-role="button">
      <view class="export-ico tone-blue">图</view>
      <view class="export-option-main">
        <view class="export-option-name">存一张清单长图</view>
        <view class="export-option-desc">合计自评 + 五板块 + 全部记录，一张图看完</view>
      </view>
      <text class="chevron">›</text>
    </view>

    <view class="export-option" bindtap="savePhotos" aria-role="button">
      <view class="export-ico tone-green">照</view>
      <view class="export-option-main">
        <view class="export-option-name">把照片存进相册</view>
        <view class="export-option-desc">共 {{photoCount}} 张，逐张保存，水印已经打进图里</view>
      </view>
      <text class="chevron">›</text>
    </view>

    <view class="export-foot">清单图只包含分数与文字，不含照片；照片走第二个入口单独保存。</view>
  </view>
</view>

<!-- 离屏画布：生成清单图用，放在页面最外层 -->
<canvas type="2d" id="exportCanvas" class="export-canvas"></canvas>
