.table-head,
.table-body { display: flex; }
.table-head { height: 96rpx; background: var(--surface-4); border-bottom: 1rpx solid var(--line); }
.period-head { display: flex; width: 76rpx; flex: none; flex-direction: column; align-items: center; justify-content: center; color: var(--text); line-height: 1.1; }
.period-month { font-size: calc(24rpx * var(--fs, 1)); font-weight: 700; }
.period-month-unit { margin-top: 2rpx; color: var(--muted); font-size: calc(18rpx * var(--fs, 1)); }
.day-head { display: flex; flex: 1; min-width: 0; flex-direction: column; align-items: center; justify-content: center; color: var(--muted); line-height: 1.15; }
.day-week { font-size: calc(21rpx * var(--fs, 1)); }
.day-date { margin-top: 4rpx; color: var(--ink-4); font-size: calc(20rpx * var(--fs, 1)); }
.day-head.today .day-week, .day-head.today .day-date { color: var(--brand); font-weight: 700; }
.day-head.today { background: var(--brand-light); color: var(--brand); font-weight: 700; }

.period-column { width: 76rpx; flex: none; border-right: 1rpx solid var(--line); }
.period-cell {
  box-sizing: border-box;
  height: 110rpx; /* = ROW_HEIGHT，两边必须一致 */
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 6rpx;
  border-bottom: 1rpx dashed var(--line);
  color: var(--muted);
  font-size: calc(16rpx * var(--fs, 1));
  line-height: 1.25;
}
.period-number { color: var(--text); font-size: calc(23rpx * var(--fs, 1)); font-weight: 700; }
.period-cell.active { background: var(--surface-20); }
.period-cell.active .period-number { color: var(--tone-amber-deep); }

.day-column { position: relative; flex: 1; min-width: 0; border-right: 1rpx solid var(--line); }
.day-column:last-child { border-right: 0; }
.today-column { background: var(--surface-2); }
.grid-cell { box-sizing: border-box; height: 110rpx; border-bottom: 1rpx dashed var(--line); }

.course-block {
  position: absolute;
  right: 4rpx;
  left: 4rpx;
  box-sizing: border-box;
  overflow: hidden;
  padding: 7rpx 6rpx;
  border-radius: 12rpx;
  font-size: calc(18rpx * var(--fs, 1));
  line-height: 1.2;
  box-shadow: 0 2rpx 8rpx rgba(22, 32, 49, .05);
}
/* 底和字都由内联 style 给出（一门课一对颜色），这里只补"正在进行"的描边 */
.course-block.is-now { border: 3rpx solid currentColor; padding: 4rpx 3rpx; }
/*
 * 格子里只有一列宽（约 90px）。课名最多两行，下面按「@校区 / 地点 / 教师」
 * 一行一条竖着排；单节次的格子只有 88rpx 高，塞不下教师，直接省略。
 */
.course-name {
  font-size: calc(20rpx * var(--fs, 1));
  font-weight: 700;
  line-height: 1.2;
  word-break: break-all;
}
.course-meta {
  margin-top: 2rpx;
  font-size: calc(16rpx * var(--fs, 1));
  line-height: 1.22;
  opacity: .88;
  word-break: break-all;
}
.course-block.is-short .course-teacher { display: none; }
.course-block.is-short { padding: 5rpx; }


/*
 * 百宝箱浮动球。
 * 【为什么用 px 不用 rpx】position: fixed 的 left/top 是逻辑像素，
 * 拖动时用 rpx 换算会差一个 dpr 的倍数，手感会飘；这里统一 px，
 * JS 侧拿到的 clientX/clientY 也是 px，不需要任何换算。
 */
.tool-fab {
  position: fixed;
  z-index: 40;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 52px;
  height: 52px;
  border-radius: 50%;
  background: linear-gradient(140deg, #3d95ff 0%, #007aff 62%, #0062d6 100%);
  box-shadow: 0 10rpx 26rpx rgba(0, 106, 220, .38), inset 0 1rpx 0 rgba(255, 255, 255, .4);
  transition: transform .16s ease, box-shadow .16s ease, opacity .16s ease;
}
.tool-fab.is-dragging {
  transform: scale(1.08);
  opacity: .92;
  box-shadow: 0 16rpx 34rpx rgba(0, 106, 220, .5);
  transition: none;
}
.tool-fab-icon { width: 26px; height: 26px; }

.empty-state { margin-top: 20rpx; padding: 90rpx 50rpx 110rpx; border-radius: 24rpx; background: var(--surface-1); text-align: center; }
.empty-owl { display: block; width: 220rpx; height: 220rpx; margin: 0 auto 18rpx; }
.empty-title { font-size: calc(32rpx * var(--fs, 1)); font-weight: 700; }
.empty-copy { margin-top: 10rpx; color: var(--muted); font-size: calc(24rpx * var(--fs, 1)); }
.empty-button { margin-top: 36rpx; }

/* 底部弹层（百宝箱 / 选周 / 分享）：遮罩淡入 + 面板自底部滑入。
   只动 transform 和 opacity，不触发重排；位移取面板自身高度，看不到中间残影。 */
.mask { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 200; display: flex; align-items: flex-end; background: rgba(13, 19, 29, .48); animation: mask-fade-in .22s ease-out; }
.sheet { width: 100%; box-sizing: border-box; max-height: 84vh; overflow-y: auto; padding: 34rpx 28rpx 38rpx; border-radius: 34rpx 34rpx 0 0; background: var(--surface-1); animation: sheet-rise .3s cubic-bezier(.22, .61, .36, 1); }
@keyframes mask-fade-in { from { opacity: 0; } to { opacity: 1; } }
@keyframes sheet-rise { from { transform: translateY(100%); } to { transform: translateY(0); } }
.sheet-title { margin-bottom: 28rpx; font-size: calc(34rpx * var(--fs, 1)); font-weight: 700; }
.week-grid { display: grid; grid-template-columns: repeat(6, 1fr); gap: 16rpx; margin-bottom: 30rpx; }
.week-option { height: 68rpx; border: 1rpx solid var(--line); border-radius: 18rpx; background: var(--surface-6); font-size: calc(25rpx * var(--fs, 1)); line-height: 68rpx; text-align: center; }
.week-option.active { border-color: var(--brand); background: var(--brand); color: #fff; font-weight: 700; }

.detail-sheet { padding-bottom: 44rpx; }
.detail-title { display: flex; align-items: center; gap: 18rpx; margin-bottom: 22rpx; font-size: calc(36rpx * var(--fs, 1)); font-weight: 700; }
.detail-dot { width: 24rpx; height: 24rpx; flex: none; border-radius: 7rpx; }
.detail-list { margin-bottom: 30rpx; border-top: 1rpx solid var(--line); }
.detail-row { display: flex; justify-content: space-between; gap: 30rpx; padding: 22rpx 0; border-bottom: 1rpx solid var(--line); font-size: calc(26rpx * var(--fs, 1)); }
.detail-row > text { flex: none; color: var(--muted); }
.detail-row > view { text-align: right; }
.detail-subline { display: block; margin-top: 4rpx; color: var(--muted); font-size: calc(22rpx * var(--fs, 1)); }

/* ---------------- 顶部视图切换 + 记事本 ---------------- */

/*
 * 切换动画对齐开源方案（SwiperTab / wx-scrollable-tab-view）：
 * 两个视图常驻在一条 200% 宽的轨道上，切换时轨道整体平移，
 * 滑动全程两页内容都真实可见；指示器同步滑动。
 */
.view-switch {
  position: relative;
  display: flex;
  margin: 4rpx 0 16rpx;
  padding: 6rpx;
  border-radius: 18rpx;
  background: var(--surface-27);
}
.view-indicator {
  position: absolute;
  top: 6rpx;
  bottom: 6rpx;
  left: 6rpx;
  width: calc((100% - 12rpx) / 2);
  border-radius: 14rpx;
  background: var(--surface-1);
  box-shadow: 0 2rpx 8rpx rgba(22, 32, 49, .08);
  transition: transform .28s cubic-bezier(.22, .61, .36, 1);
}
.view-indicator.right { transform: translateX(100%); }
.view-item {
  position: relative;
  flex: 1;
  padding: 14rpx 0;
  border-radius: 14rpx;
  color: var(--muted);
  font-size: calc(25rpx * var(--fs, 1));
  text-align: center;
  transition: color .2s ease;
}
.view-item.active { color: var(--text); font-weight: 600; }

.view-viewport { overflow: hidden; }
.view-track {
  display: flex;
  width: 200%;
  transition: transform .3s cubic-bezier(.22, .61, .36, 1);
}
.view-page { width: 50%; flex: none; min-width: 0; }

.calendar {
  margin-top: 4rpx;
  padding: 18rpx 12rpx 10rpx;
  border-radius: 26rpx;
  background: var(--surface-1);
  box-shadow: 0 6rpx 24rpx rgba(38, 57, 88, .05);
  /*
   * 换月时网格会整体平移 26%（约 170rpx），比卡片自己的左右 padding 宽得多。
   * 不裁的话那截日期格子会溢出到卡片外面，在屏幕最左边露出一条边——
   * 课表卡一直有 overflow: hidden，所以只有日历出现过这个现象。
   */
  overflow: hidden;
}
.calendar-head { display: flex; align-items: center; justify-content: space-between; padding: 2rpx 4rpx 14rpx; }
.month-nav { width: 64rpx; height: 64rpx; border-radius: 18rpx; background: var(--brand-light); color: var(--brand); font-size: calc(38rpx * var(--fs, 1)); line-height: 60rpx; text-align: center; }
.month-nav:active { opacity: .65; }
.month-title { display: flex; align-items: baseline; gap: 12rpx; font-size: calc(34rpx * var(--fs, 1)); font-weight: 700; }
.month-meta { color: var(--muted); font-size: calc(21rpx * var(--fs, 1)); font-weight: 400; }

.weekdays { display: flex; padding: 4rpx 0 6rpx; }
.weekday { flex: 1; color: var(--muted); font-size: calc(20rpx * var(--fs, 1)); text-align: center; }

.grid { display: flex; flex-wrap: wrap; }
.cell { box-sizing: border-box; display: flex; flex-direction: column; align-items: center; justify-content: center; width: 14.2857%; height: 94rpx; border-radius: 18rpx; }
.cell.dim .day-number { color: var(--ink-1); }
.day-number { font-size: calc(30rpx * var(--fs, 1)); line-height: 1.1; }
.dot { width: 8rpx; height: 8rpx; margin-top: 8rpx; border-radius: 50%; background: transparent; }
.dot.show { background: var(--brand); }
.cell.today .day-number { color: var(--brand); font-weight: 700; }
.cell.selected { background: var(--brand); }
.cell.selected .day-number { color: #fff; font-weight: 700; }
.cell.selected .dot.show { background: var(--surface-1); }

.day-head { display: flex; align-items: center; justify-content: space-between; padding: 26rpx 10rpx 12rpx; }
.day-title { font-size: calc(27rpx * var(--fs, 1)); font-weight: 600; }
.day-action { color: var(--brand); font-size: calc(22rpx * var(--fs, 1)); }

.note-row { display: flex; align-items: center; min-height: 126rpx; padding: 18rpx 22rpx; border-bottom: 1rpx solid var(--line); }
.note-row:last-child { border-bottom: 0; }
.check { width: 42rpx; height: 42rpx; flex: none; border: 3rpx solid var(--brand); border-radius: 50%; color: #fff; background: var(--surface-1); font-size: calc(24rpx * var(--fs, 1)); line-height: 38rpx; text-align: center; }
.done .check { background: var(--brand); }
.note-main { flex: 1; min-width: 0; padding: 0 18rpx; }
.note-title { overflow: hidden; font-size: calc(29rpx * var(--fs, 1)); font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
.done .note-title { color: var(--muted); text-decoration: line-through; }
.note-copy { margin-top: 6rpx; overflow: hidden; color: var(--muted); font-size: calc(23rpx * var(--fs, 1)); text-overflow: ellipsis; white-space: nowrap; }
.note-time { margin-top: 6rpx; color: var(--brand); font-size: calc(21rpx * var(--fs, 1)); }
.remove { flex: none; padding: 18rpx 4rpx; color: var(--danger); font-size: calc(23rpx * var(--fs, 1)); }

.note-empty { padding: 54rpx 30rpx 62rpx; color: var(--muted); text-align: center; }
.note-empty-owl { display: block; width: 170rpx; height: 170rpx; margin: 0 auto 10rpx; }
.note-empty-copy { margin-top: 10rpx; font-size: calc(22rpx * var(--fs, 1)); }

.add-bar { margin: 22rpx 4rpx 0; padding: 22rpx; border: 1rpx dashed rgba(0, 122, 255, .38); border-radius: 20rpx; background: rgba(0, 122, 255, .05); color: var(--brand); font-size: calc(24rpx * var(--fs, 1)); text-align: center; }
.add-bar:active { background: rgba(0, 122, 255, .12); }

/* 「本周」小按钮：只在本周以外出现，贴在右箭头右边 */
.today-chip {
  flex: none;
  margin-left: 6rpx;
  padding: 9rpx 14rpx;
  border-radius: 999rpx;
  background: var(--brand-light);
  color: var(--brand);
  font-size: calc(19rpx * var(--fs, 1));
  font-weight: 600;
  white-space: nowrap;
}
.today-chip:active { background: rgba(0, 122, 255, .18); }


/* ---------------- 百宝箱弹层 ---------------- */

.toolbox-sheet { padding-bottom: calc(30rpx + env(safe-area-inset-bottom)); }
.toolbox-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; margin-bottom: 26rpx; }
.toolbox-title { margin-bottom: 8rpx; }
.toolbox-copy { color: var(--muted); font-size: calc(22rpx * var(--fs, 1)); }
.toolbox-close {
  flex: none;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: var(--surface-16);
  color: var(--muted);
  font-size: calc(22rpx * var(--fs, 1));
}
.toolbox-close:active { background: var(--surface-28); }

.tool-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14rpx; }
.tool-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  padding: 22rpx 10rpx 18rpx;
  border-radius: 22rpx;
  background: var(--surface-5);
  text-align: center;
}
.tool-item:active { background: var(--surface-21); }
.tool-ico {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  overflow: hidden;
  border-radius: 22rpx;
}
/* 图标是 24×24 线性稿按 144px 预渲染的白描边 PNG，压到 40rpx 才不会糊 */
.tool-ico-img { width: 40rpx; height: 40rpx; }
.tone-blue { background: linear-gradient(140deg, #4d9dff, #007aff); }
.tone-green { background: linear-gradient(140deg, #45c48b, #16a163); }
.tone-indigo { background: linear-gradient(140deg, #7f8dff, #4b57d8); }
.tone-gray { background: linear-gradient(140deg, #a6b0c0, #7d8899); }
.tone-orange { background: linear-gradient(140deg, #ffb057, #f0810f); }
.tone-teal { background: linear-gradient(140deg, #4dc9c4, #12938e); }
.tool-name { color: var(--text); font-size: calc(24rpx * var(--fs, 1)); font-weight: 600; }
.tool-desc { color: var(--ink-4); font-size: calc(19rpx * var(--fs, 1)); line-height: 1.3; }

/* 百宝箱里那条通栏的「分享我的课表」 */
.tool-wide {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 12rpx;
  padding: 20rpx 18rpx;
  border-radius: 20rpx;
  background: linear-gradient(120deg, #eef4ff, #f6f9ff);
}
.tool-wide:active { background: var(--surface-25); }
.tool-wide-ico {
  display: flex;
  width: 60rpx;
  height: 60rpx;
  flex: none;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  background: var(--brand);
}
.tool-wide-ico-img { width: 34rpx; height: 34rpx; }
.tool-wide-main { flex: 1; min-width: 0; }
.tool-wide-title { color: var(--text); font-size: calc(25rpx * var(--fs, 1)); font-weight: 600; }
.tool-wide-copy { margin-top: 4rpx; color: var(--muted); font-size: calc(20rpx * var(--fs, 1)); }

/* 离屏画布：不能 display:none，否则拿不到 node */
.share-canvas {
  position: fixed;
  top: 0;
  left: -9999rpx;
  width: 375px;
  height: 600px;
}

/* 扫码打开别人分享的课表时，顶部提示条 */
.share-banner {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 14rpx;
  padding: 20rpx 20rpx;
  border-radius: 20rpx;
  background: linear-gradient(120deg, #eaf3ff, #f4f9ff);
  border: 1rpx solid rgba(0, 122, 255, .16);
}
.share-banner-main { flex: 1; min-width: 0; }
.share-banner-title { color: var(--text); font-size: calc(25rpx * var(--fs, 1)); font-weight: 600; }
.share-banner-copy { margin-top: 4rpx; color: var(--muted); font-size: calc(20rpx * var(--fs, 1)); }
.share-banner-btn {
  flex: none;
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: var(--brand);
  color: #fff;
  font-size: calc(22rpx * var(--fs, 1));
  font-weight: 600;
}

/* ---------------- 分享预览 ---------------- */

.share-sheet { display: flex; flex-direction: column; max-height: 88vh; }
.share-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; padding: 2rpx 4rpx 20rpx; }
.share-head-main { flex: 1; min-width: 0; }
.share-title { color: var(--text); font-size: calc(34rpx * var(--fs, 1)); font-weight: 700; }
.share-sub { margin-top: 6rpx; color: var(--muted); font-size: calc(22rpx * var(--fs, 1)); }
.share-close { flex: none; padding: 10rpx 22rpx; border-radius: 999rpx; background: var(--surface-16); color: var(--muted); font-size: calc(22rpx * var(--fs, 1)); }

/*
 * 预览区高度写死 58vh 而不是 flex:1。
 * scroll-view 在 flex 列里靠 flex 分配高度会塌成 0（项目踩过好几次），
 * 给确定高度最省事。
 */
.share-preview { height: 58vh; border-radius: 20rpx; background: var(--surface-16); }
.share-image { display: block; width: 100%; }

.share-actions { display: flex; gap: 16rpx; padding-top: 22rpx; }
.share-btn { flex: 1; height: 88rpx; border-radius: 22rpx; font-size: calc(28rpx * var(--fs, 1)); font-weight: 600; line-height: 88rpx; text-align: center; }
.share-btn.ghost { background: var(--surface-16); color: var(--text); }
.share-btn.primary { background: var(--brand); color: #fff; }
