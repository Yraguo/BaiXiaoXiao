 * 只动 transform 和 opacity，不触发重排。
 */
.week-card.week-in-right,
.timetable-card.week-in-right { animation: week-in-right .24s cubic-bezier(.22, .61, .36, 1); }

.week-card.week-in-left,
.timetable-card.week-in-left { animation: week-in-left .24s cubic-bezier(.22, .61, .36, 1); }

@keyframes week-in-right {
  from { opacity: .3; transform: translateX(56rpx); }
  to { opacity: 1; transform: translateX(0); }
}

@keyframes week-in-left {
  from { opacity: .3; transform: translateX(-56rpx); }
  to { opacity: 1; transform: translateX(0); }
}

.table-head,
.table-body { display: flex; }
.table-head { height: 96rpx; background: #f8f9fc; border-bottom: 1rpx solid var(--line); }
.period-head { display: flex; width: 76rpx; flex: none; flex-direction: column; align-items: center; justify-content: center; color: var(--text); line-height: 1.1; }
.period-month { font-size: 24rpx; font-weight: 700; }
.period-month-unit { margin-top: 2rpx; color: var(--muted); font-size: 18rpx; }
.day-head { display: flex; flex: 1; min-width: 0; flex-direction: column; align-items: center; justify-content: center; color: var(--muted); line-height: 1.15; }
.day-week { font-size: 20rpx; }
.day-date { margin-top: 4rpx; color: #b3bac5; font-size: 19rpx; }
.day-head.today .day-week, .day-head.today .day-date { color: var(--brand); font-weight: 700; }
.day-head.today { background: var(--brand-light); color: var(--brand); font-weight: 700; }

.period-column { width: 76rpx; flex: none; border-right: 1rpx solid var(--line); }
.period-cell {
  box-sizing: border-box;
  height: 96rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 6rpx;
  border-bottom: 1rpx dashed var(--line);
  color: var(--muted);
  font-size: 16rpx;
  line-height: 1.25;
}
.period-number { color: var(--text); font-size: 22rpx; font-weight: 700; }
.period-cell.active { background: #fff6e6; }
.period-cell.active .period-number { color: #b66b00; }

.day-column { position: relative; flex: 1; min-width: 0; border-right: 1rpx solid var(--line); }
.day-column:last-child { border-right: 0; }
.today-column { background: #f8faff; }
.grid-cell { box-sizing: border-box; height: 96rpx; border-bottom: 1rpx dashed var(--line); }

.course-block {
  position: absolute;
  right: 4rpx;
  left: 4rpx;
  box-sizing: border-box;
  overflow: hidden;
  padding: 8rpx 7rpx;
  border-radius: 12rpx;
  font-size: 17rpx;
  line-height: 1.2;
  box-shadow: 0 2rpx 8rpx rgba(22, 32, 49, .05);
}
/* 底和字都由内联 style 给出（一门课一对颜色），这里只补"正在进行"的描边 */
.course-block.is-now { border: 3rpx solid currentColor; padding: 5rpx 4rpx; }
/*
 * 格子里只有一列宽（约 90px）。课名最多两行，下面按「@校区 / 地点 / 教师」
 * 一行一条竖着排；单节次的格子只有 88rpx 高，只留课名和教室。
 */
.course-name {
  font-size: 18rpx;
  font-weight: 700;
  line-height: 1.22;
  word-break: break-all;
}
.course-meta {
  margin-top: 3rpx;
  font-size: 14rpx;
  line-height: 1.25;
  opacity: .85;
  word-break: break-all;
}
.course-block.is-short { padding: 6rpx; }


/*
 * 悬浮操作按钮。
 * 【真机坑】原先用 <button> 且容器只给了 right 没给 left，iOS 上按钮会被拉成
 * 长胶囊（宽约 320rpx），并因为叠加了 .safe-bottom 的安全区 padding 而浮到
 * 课表中间。改为 view + 显式锁定宽高（flex: 0 0 92rpx）后与平台无关。
 */
.floating-actions {
  position: fixed;
  right: 28rpx;
  left: auto;
  bottom: calc(36rpx + env(safe-area-inset-bottom));
  z-index: 20;
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.circle-button {
  display: flex;
  flex: 0 0 92rpx;
  align-items: center;
  justify-content: center;
  width: 92rpx;
  min-width: 92rpx;
  max-width: 92rpx;
  height: 92rpx;
  min-height: 92rpx;
  max-height: 92rpx;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
  border-radius: 50%;
  overflow: hidden;
  box-shadow: 0 12rpx 28rpx rgba(32, 49, 78, .22);
}

.settings-button { background: #fff; color: #42506a; font-size: 34rpx; }
.add-button { background: var(--brand); color: #fff; font-size: 48rpx; }

.empty-state { padding: 90rpx 50rpx 110rpx; border-radius: 24rpx; background: #fff; text-align: center; }
.empty-owl { display: block; width: 220rpx; height: 220rpx; margin: 0 auto 18rpx; }
.empty-title { font-size: 32rpx; font-weight: 700; }
.empty-copy { margin-top: 10rpx; color: var(--muted); font-size: 24rpx; }
.empty-button { margin-top: 36rpx; }

.mask { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 50; display: flex; align-items: flex-end; background: rgba(13, 19, 29, .48); }
.sheet { width: 100%; box-sizing: border-box; max-height: 84vh; overflow-y: auto; padding: 34rpx 28rpx 38rpx; border-radius: 34rpx 34rpx 0 0; background: #fff; }
.sheet-title { margin-bottom: 28rpx; font-size: 34rpx; font-weight: 700; }
.week-grid { display: grid; grid-template-columns: repeat(6, 1fr); gap: 16rpx; margin-bottom: 30rpx; }
.week-option { height: 68rpx; border: 1rpx solid var(--line); border-radius: 18rpx; background: #f8f9fb; font-size: 25rpx; line-height: 68rpx; text-align: center; }
.week-option.active { border-color: var(--brand); background: var(--brand); color: #fff; font-weight: 700; }

.detail-sheet { padding-bottom: 44rpx; }
.detail-title { display: flex; align-items: center; gap: 18rpx; margin-bottom: 22rpx; font-size: 36rpx; font-weight: 700; }
.detail-dot { width: 24rpx; height: 24rpx; flex: none; border-radius: 7rpx; }
.detail-list { margin-bottom: 30rpx; border-top: 1rpx solid var(--line); }
.detail-row { display: flex; justify-content: space-between; gap: 30rpx; padding: 22rpx 0; border-bottom: 1rpx solid var(--line); font-size: 26rpx; }
.detail-row > text { flex: none; color: var(--muted); }
.detail-row > view { text-align: right; }
.detail-subline { display: block; margin-top: 4rpx; color: var(--muted); font-size: 22rpx; }

/* ---------------- 顶部视图切换 + 记事本 ---------------- */

/*
 * 切换动画对齐开源方案（SwiperTab / wx-scrollable-tab-view）：
 * 两个视图常驻在一条 200% 宽的轨道上，切换时轨道整体平移，
 * 滑动全程两页内容都真实可见；指示器同步滑动。
 */
.view-switch {
  position: relative;
  display: flex;
  margin: 4rpx 0 16rpx;
  padding: 6rpx;
  border-radius: 18rpx;
  background: #e9ebf0;
}
.view-indicator {
  position: absolute;
  top: 6rpx;
  bottom: 6rpx;
  left: 6rpx;
  width: calc((100% - 12rpx) / 2);
  border-radius: 14rpx;
  background: #fff;
  box-shadow: 0 2rpx 8rpx rgba(22, 32, 49, .08);
  transition: transform .28s cubic-bezier(.22, .61, .36, 1);
}
.view-indicator.right { transform: translateX(100%); }
.view-item {
  position: relative;
  flex: 1;
  padding: 14rpx 0;
  border-radius: 14rpx;
  color: var(--muted);
  font-size: 25rpx;
  text-align: center;
  transition: color .2s ease;
}
.view-item.active { color: var(--text); font-weight: 600; }

.view-viewport { overflow: hidden; }
.view-track {
  display: flex;
  width: 200%;
  transition: transform .3s cubic-bezier(.22, .61, .36, 1);
}
.view-page { width: 50%; flex: none; min-width: 0; }

.calendar {
  margin-top: 4rpx;
  padding: 18rpx 12rpx 10rpx;
  border-radius: 26rpx;
  background: #fff;
  box-shadow: 0 6rpx 24rpx rgba(38, 57, 88, .05);
}
.calendar-head { display: flex; align-items: center; justify-content: space-between; padding: 2rpx 4rpx 14rpx; }
.month-nav { width: 64rpx; height: 64rpx; border-radius: 18rpx; background: var(--brand-light); color: var(--brand); font-size: 38rpx; line-height: 60rpx; text-align: center; }
.month-nav:active { opacity: .65; }
.month-title { display: flex; align-items: baseline; gap: 12rpx; font-size: 34rpx; font-weight: 700; }
.month-meta { color: var(--muted); font-size: 21rpx; font-weight: 400; }

.weekdays { display: flex; padding: 4rpx 0 6rpx; }
.weekday { flex: 1; color: var(--muted); font-size: 20rpx; text-align: center; }

.grid { display: flex; flex-wrap: wrap; }
.cell { box-sizing: border-box; display: flex; flex-direction: column; align-items: center; justify-content: center; width: 14.2857%; height: 94rpx; border-radius: 18rpx; }
.cell.dim .day-number { color: #c7c7cc; }
.day-number { font-size: 30rpx; line-height: 1.1; }
.dot { width: 8rpx; height: 8rpx; margin-top: 8rpx; border-radius: 50%; background: transparent; }
.dot.show { background: var(--brand); }
.cell.today .day-number { color: var(--brand); font-weight: 700; }
.cell.selected { background: var(--brand); }
.cell.selected .day-number { color: #fff; font-weight: 700; }
.cell.selected .dot.show { background: #fff; }

.day-head { display: flex; align-items: center; justify-content: space-between; padding: 26rpx 10rpx 12rpx; }
.day-title { font-size: 27rpx; font-weight: 600; }
.day-action { color: var(--brand); font-size: 22rpx; }

.note-row { display: flex; align-items: center; min-height: 126rpx; padding: 18rpx 22rpx; border-bottom: 1rpx solid var(--line); }
.note-row:last-child { border-bottom: 0; }
.check { width: 42rpx; height: 42rpx; flex: none; border: 3rpx solid var(--brand); border-radius: 50%; color: #fff; background: #fff; font-size: 24rpx; line-height: 38rpx; text-align: center; }
.done .check { background: var(--brand); }
.note-main { flex: 1; min-width: 0; padding: 0 18rpx; }
.note-title { overflow: hidden; font-size: 29rpx; font-weight: 600; text-overflow: ellipsis; white-space: nowrap; }
.done .note-title { color: var(--muted); text-decoration: line-through; }
.note-copy { margin-top: 6rpx; overflow: hidden; color: var(--muted); font-size: 23rpx; text-overflow: ellipsis; white-space: nowrap; }
.note-time { margin-top: 6rpx; color: var(--brand); font-size: 21rpx; }
.remove { flex: none; padding: 18rpx 4rpx; color: var(--danger); font-size: 23rpx; }

.note-empty { padding: 54rpx 30rpx 62rpx; color: var(--muted); text-align: center; }
.note-empty-owl { display: block; width: 170rpx; height: 170rpx; margin: 0 auto 10rpx; }
.note-empty-copy { margin-top: 10rpx; font-size: 22rpx; }

.add-bar { margin: 22rpx 4rpx 0; padding: 22rpx; border: 1rpx dashed rgba(0, 122, 255, .38); border-radius: 20rpx; background: rgba(0, 122, 255, .05); color: var(--brand); font-size: 24rpx; text-align: center; }
.add-bar:active { background: rgba(0, 122, 255, .12); }

/* 「本周」小按钮：只在本周以外出现，贴在右箭头右边 */
.today-chip {
  flex: none;
  margin-left: 6rpx;
  padding: 9rpx 14rpx;
  border-radius: 999rpx;
  background: var(--brand-light);
  color: var(--brand);
  font-size: 19rpx;
  font-weight: 600;
  white-space: nowrap;
}
.today-chip:active { background: rgba(0, 122, 255, .18); }
