<scroll-view
  class="tab-scroll"
  scroll-y
  refresher-enabled="{{true}}"
  refresher-triggered="{{refresherOn}}"
  bindrefresherrefresh="onPullRefresh"
>
<view class="page">
  <!-- 课表 / 记事本：两个视图常驻在一条水平轨道上，切换时整条轨道平移。
       做法对齐开源的 SwiperTab / wx-scrollable-tab-view：
       与"删旧视图再渲染新的"相比，滑动过程中两页内容都真实可见 -->
  <view class="view-switch">
    <view class="view-indicator {{view === 'notes' ? 'right' : ''}}"></view>
    <view
      class="view-item {{view === 'timetable' ? 'active' : ''}}"
      data-view="timetable"
      bindtap="switchView"
    >课表</view>
    <view
      class="view-item {{view === 'notes' ? 'active' : ''}}"
      data-view="notes"
      bindtap="switchView"
    >记事本</view>
  </view>

  <view class="view-viewport">
  <view class="view-track" style="transform:translateX({{view === 'notes' ? '-50%' : '0%'}})">
    <view class="view-page">
  <view wx:if="{{shared}}" class="share-banner">
    <view class="share-banner-main">
      <view class="share-banner-title">这是分享的课表</view>
      <view class="share-banner-copy">{{shared.term}} · {{shared.count}} 门课 · 只读</view>
    </view>
    <view class="share-banner-btn" bindtap="saveShared">存到我的课表</view>
  </view>

  <view wx:if="{{!hasCourses}}" class="empty-state">
    <image class="empty-owl" src="/assets/owl/owl-study.png" mode="aspectFit"></image>
    <view class="empty-title">还没有课程</view>
    <view class="empty-copy">添加第一门课，开始安排你的学期。</view>
    <button class="primary-button empty-button" bindtap="addCourse">添加课程</button>
    <button class="secondary-button empty-button" bindtap="openImport">导入课表</button>
  </view>

  <!-- 左右滑动换周只在课表方框内生效。
       touchstart 用 bind 不用 catch：catch 会把这次触摸从 scroll-view 的手势
       识别里摘出去，表现为「能左右切周、但上下拖不动」（踩过）。
       只 catch 住 touchend，容器页就收不到这次手势，不会误切 tab。 -->
  <view wx:else class="timetable-card {{weekAnim}}" bindtouchstart="rememberTouch" catchtouchend="finishTouch">
    <view class="table-head">
      <view class="period-head">
        <text class="period-month">{{headMonth}}</text>
        <text class="period-month-unit">月</text>
      </view>
      <view
        wx:for="{{dayColumns}}"
        wx:key="dayIndex"
        class="day-head {{item.isToday ? 'today' : ''}}"
      >
        <view class="day-week">{{item.weekChar}}</view>
        <text class="day-date">{{item.dayNum}}</text>
      </view>
    </view>
    <view class="table-body">
      <view class="period-column">
        <view
          wx:for="{{periodRows}}"
          wx:key="period"
          class="period-cell {{item.active ? 'active' : ''}}"
        >
          <text class="period-number">{{item.period}}</text>
          <text>{{item.start}}</text>
          <text>{{item.end}}</text>
        </view>
      </view>
      <view
        wx:for="{{dayColumns}}"
        wx:key="dayIndex"
        wx:for-item="day"
        class="day-column {{day.isToday ? 'today-column' : ''}}"
      >
        <view wx:for="{{periodRows}}" wx:key="period" class="grid-cell"></view>
        <view
          wx:for="{{day.blocks}}"
          wx:key="id"
          wx:for-item="course"
          class="course-block {{course.isNow ? 'is-now' : ''}} {{course.short ? 'is-short' : ''}}"
          style="{{course.style}}"
          data-id="{{course.id}}"
          catchtap="showCourse"
        >
          <view class="course-name">{{course.name}}</view>
          <view wx:if="{{course.room}}" class="course-meta course-room">{{course.campus ? course.campus + ' ' : ''}}{{course.room}}</view>
          <view wx:if="{{course.teacher}}" class="course-meta course-teacher">{{course.teacher}}</view>
        </view>
      </view>
    </view>
  </view>

  <view class="week-card">
    <!-- 用 view 而不是 button：button 在 flex 容器里宽度约束会失效，曾把中间的周次挤成竖排单字 -->
    <view
      class="week-arrow {{week <= 1 ? 'is-disabled' : ''}}"
      bindtap="previousWeek"
      aria-role="button"
      aria-label="上一周"
    >‹</view>
    <view class="week-center" bindtap="openWeekPicker">
      <view class="week-heading">
        <text class="week-num">第 {{week}} 周</text>
        <text class="week-range">{{weekTitle}}</text>
      </view>
      <view class="semester">{{settings.timetableName}} · 共 {{settings.totalWeeks}} 周</view>
    </view>
    <view
      class="week-arrow {{week >= settings.totalWeeks ? 'is-disabled' : ''}}"
      bindtap="nextWeek"
      aria-role="button"
      aria-label="下一周"
    >›</view>
    <view wx:if="{{week !== currentWeek}}" class="today-chip" bindtap="goCurrentWeek">回到本周</view>
  </view>

  <view wx:if="{{nextCourse}}" class="next-card" data-id="{{nextCourse.id}}" bindtap="showCourse">
    <view class="next-dot" style="background:{{nextCourse.color}}"></view>
    <view class="next-content">
      <view class="next-title">{{nextCourse.name}} <text>{{nextCourse.countdown}}</text></view>
      <view class="next-meta">{{nextCourse.dayLabel}} · 第 {{nextCourse.startPeriod}}–{{nextCourse.endPeriod}} 节 {{nextCourse.timeText}} · {{nextCourse.room}}</view>
    </view>
    <text class="chevron">›</text>
  </view>

    </view>

    <view class="view-page">
    <view class="notes-layer">
    <!-- 日历方框内左右滑动换月，同样只 catch touchend -->
    <view class="calendar" bindtouchstart="rememberTouch" catchtouchend="finishTouch">
      <view class="calendar-head">
        <view class="month-nav" bindtap="previousMonth" aria-role="button" aria-label="上个月">‹</view>
        <view class="month-title" bindtap="goToday">
          <text>{{monthText}}</text>
          <text class="month-meta">{{monthTotal}} 条</text>
        </view>
        <view class="month-nav" bindtap="nextMonth" aria-role="button" aria-label="下个月">›</view>
      </view>

      <view class="weekdays">
        <text wx:for="{{weekdays}}" wx:key="*this" class="weekday">{{item}}</text>
      </view>

      <!--
        换月用交叉淡入淡出：旧月份留一层影子在下面淡出，新月份在上面淡入。
        之前是横向滑 8%，日期数字会被卡片边缘切掉半截，看着像屏幕左侧多了一条边。
        淡入淡出没有位移，永远不会切到数字。
      -->
      <view class="month-body">
        <view wx:if="{{ghostCells.length}}" class="grid grid-ghost {{ghostDir}}">
          <view
            wx:for="{{ghostCells}}"
            wx:key="date"
            class="cell {{item.inMonth ? '' : 'dim'}} {{item.isToday ? 'today' : ''}} {{item.isSelected ? 'selected' : ''}}"
          >
            <text class="day-number">{{item.day}}</text>
            <view class="dot {{item.hasNote ? 'show' : ''}}"></view>
          </view>
        </view>
        <view class="grid {{monthAnim}}">
          <view
            wx:for="{{cells}}"
            wx:key="date"
            class="cell {{item.inMonth ? '' : 'dim'}} {{item.isToday ? 'today' : ''}} {{item.isSelected ? 'selected' : ''}}"
            data-date="{{item.date}}"
            bindtap="selectDay"
          >
            <text class="day-number">{{item.day}}</text>
            <view class="dot {{item.hasNote ? 'show' : ''}}"></view>
          </view>
        </view>
      </view>
    </view>

    <view class="day-bar">
      <text class="day-title">{{selectedLabel}}</text>
      <text class="day-action" bindtap="goToday">回到今天</text>
    </view>

    <view wx:if="{{!dayNotes.length}}" class="card note-empty">
      <image class="note-empty-owl" src="/assets/owl/owl-sleep.png" mode="aspectFit"></image>
      <view>这一天还没有记事</view>
      <view class="note-empty-copy">点下面的按钮，给这一天记点事</view>
    </view>

    <view wx:else class="card">
      <view wx:for="{{dayNotes}}" wx:key="id" class="note-row {{item.done ? 'done' : ''}}">
        <view class="check" data-id="{{item.id}}" bindtap="toggleDone">{{item.done ? '✓' : ''}}</view>
        <view class="note-main" data-id="{{item.id}}" bindtap="editNote">
          <view class="note-title">{{item.title}}</view>
          <view class="note-copy">{{item.content || '无补充内容'}}</view>
          <view wx:if="{{item.remindAt}}" class="note-time">{{item.remindAt}}</view>
        </view>
        <view class="remove" data-id="{{item.id}}" bindtap="removeNote">删除</view>
      </view>
    </view>

    <view class="add-bar" bindtap="addNote">＋ 在 {{selectedLabel}} 添加记事</view>
    </view>
    </view>
  </view>
  </view>

</view>
</scroll-view>

<!-- 百宝箱：可自由拖动的小球，位置限制在页面可视区内并持久化。
     只在课表视图出现 —— 记事本里没有可导入/可切周的东西，留着反而挡字 -->
<view
  wx:if="{{ballReady && !shared && view === 'timetable'}}"
  class="tool-fab {{ballDragging ? 'is-dragging' : ''}}"
  style="left:{{ballX}}px; top:{{ballY}}px;"
  catchtouchstart="onBallTouchStart"
  catchtouchmove="onBallTouchMove"
  catchtouchend="onBallTouchEnd"
  catchtouchcancel="onBallTouchEnd"
  aria-role="button"
  aria-label="百宝箱"
>
  <image class="tool-fab-icon" src="/assets/icons/toolbox.png" mode="aspectFit"></image>
</view>

<view wx:if="{{toolboxOpen}}" class="mask" bindtap="closeToolbox">
  <view class="sheet safe-bottom toolbox-sheet" catchtap="stopPropagation">
    <view class="toolbox-head">
      <view>
        <view class="sheet-title toolbox-title">百宝箱</view>
        <view class="toolbox-copy">导入、设置和随手记都在这里</view>
      </view>
      <view class="toolbox-close" bindtap="closeToolbox">关闭</view>
    </view>
    <view class="tool-grid">
      <view class="tool-item" data-key="jw" bindtap="toolboxAction" aria-role="button">
        <view class="tool-ico tone-blue"><image class="tool-ico-img" src="/assets/icons/cloud.png" mode="aspectFit"></image></view>
        <view class="tool-name">导入课表</view>
        <view class="tool-desc">学号密码一键读课表</view>
      </view>
      <view class="tool-item" data-key="pdf" bindtap="toolboxAction" aria-role="button">
        <view class="tool-ico tone-green"><image class="tool-ico-img" src="/assets/icons/doc.png" mode="aspectFit"></image></view>
        <view class="tool-name">PDF 导入</view>
        <view class="tool-desc">解析教务导出的 PDF</view>
      </view>
      <view class="tool-item" data-key="course" bindtap="toolboxAction" aria-role="button">
        <view class="tool-ico tone-indigo"><image class="tool-ico-img" src="/assets/icons/plus.png" mode="aspectFit"></image></view>
        <view class="tool-name">添加课程</view>
        <view class="tool-desc">手动填一门课</view>
      </view>
      <view class="tool-item" data-key="settings" bindtap="toolboxAction" aria-role="button">
        <view class="tool-ico tone-gray"><image class="tool-ico-img" src="/assets/icons/sliders.png" mode="aspectFit"></image></view>
        <view class="tool-name">课表设置</view>
        <view class="tool-desc">作息、学期与周数</view>
      </view>
      <view class="tool-item" data-key="note" bindtap="toolboxAction" aria-role="button">
        <view class="tool-ico tone-orange"><image class="tool-ico-img" src="/assets/icons/pencil.png" mode="aspectFit"></image></view>
        <view class="tool-name">记一件事</view>
        <view class="tool-desc">打开记事本新建</view>
      </view>
      <view class="tool-item" data-key="week" bindtap="toolboxAction" aria-role="button">
        <view class="tool-ico tone-teal"><image class="tool-ico-img" src="/assets/icons/calendar.png" mode="aspectFit"></image></view>
        <view class="tool-name">回到本周</view>
        <view class="tool-desc">第 {{currentWeek}} 周</view>
      </view>
    </view>

    <view class="tool-wide" data-key="share" bindtap="toolboxAction" aria-role="button">
      <view class="tool-wide-ico"><image class="tool-wide-ico-img" src="/assets/icons/share.png" mode="aspectFit"></image></view>
      <view class="tool-wide-main">
        <view class="tool-wide-title">分享我的课表</view>
        <view class="tool-wide-copy">生成一张第 {{week}} 周的课表图，直接发给同学</view>
      </view>
      <text class="chevron">›</text>
    </view>
  </view>
</view>

<view wx:if="{{showWeekPicker}}" class="mask" bindtap="closeWeekPicker">
  <view class="sheet safe-bottom" catchtap="stopPropagation">
    <view class="sheet-title">选择周次</view>
    <view class="week-grid">
      <view
        wx:for="{{weekOptions}}"
        wx:key="value"
        class="week-option {{item.active ? 'active' : ''}}"
        data-week="{{item.value}}"
        bindtap="selectWeek"
      >{{item.value}}</view>
    </view>
    <button class="secondary-button" bindtap="goCurrentWeek">回到本周（第 {{currentWeek}} 周）</button>
  </view>
</view>

<view wx:if="{{detail}}" class="mask" bindtap="closeDetail">
  <view class="sheet detail-sheet safe-bottom" catchtap="stopPropagation">
    <view class="detail-title">
      <view class="detail-dot" style="background:{{detail.color}}"></view>
      <text>{{detail.name}}</text>
    </view>
    <view class="detail-list">
      <view class="detail-row"><text>时间</text><view>{{detail.dayText}} {{detail.periodText}}<text class="detail-subline">{{detail.timeText}}</text></view></view>
      <view class="detail-row"><text>周次</text><view>{{detail.weeksText}}</view></view>
      <view class="detail-row"><text>校区</text><view>{{detail.campus || '未填写'}}</view></view>
      <view class="detail-row"><text>地点</text><view>{{detail.room || '未填写'}}</view></view>
      <view class="detail-row"><text>教师</text><view>{{detail.teacher || '未填写'}}</view></view>
      <view class="detail-row"><text>备注</text><view>{{detail.note || '无'}}</view></view>
    </view>
    <button class="primary-button" bindtap="editCourse">编辑课程</button>
  </view>
</view>

<!-- 离屏画布：生成课表分享图 -->
<canvas type="2d" id="shareCanvas" class="share-canvas"></canvas>

<!-- 分享预览：先让用户看清成品，再决定存相册还是直接发 -->
<view wx:if="{{sharePreview}}" class="mask" bindtap="closeSharePreview">
  <view class="sheet share-sheet safe-bottom" catchtap="stopPropagation">
    <view class="share-head">
      <view class="share-head-main">
        <view class="share-title">第 {{sharePreview.week}} 周课表</view>
        <view class="share-sub">{{sharePreview.withQr ? '带小程序码，同学扫码就能打开' : '图片模式，没开云开发也能用'}}</view>
      </view>
      <view class="share-close" bindtap="closeSharePreview" aria-role="button">关闭</view>
    </view>
    <scroll-view class="share-preview" scroll-y>
      <image class="share-image" src="{{sharePreview.path}}" mode="widthFix"></image>
    </scroll-view>
    <view class="share-actions">
      <view class="share-btn ghost" bindtap="saveShareImage" aria-role="button">保存到相册</view>
      <view class="share-btn primary" bindtap="sendShareImage" aria-role="button">发送给好友</view>
    </view>
  </view>
</view>
