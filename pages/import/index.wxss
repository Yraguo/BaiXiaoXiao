.import-page { padding: 24rpx 24rpx calc(40rpx + env(safe-area-inset-bottom)); }

.mode-switch { display: flex; gap: 6rpx; padding: 6rpx; margin-bottom: 20rpx; border-radius: 20rpx; background: rgba(120, 130, 150, .14); }
.mode-item { flex: 1; height: 70rpx; border-radius: 16rpx; color: #6b7686; font-size: 26rpx; text-align: center; line-height: 70rpx; }
.mode-item.active { background: #fff; color: var(--text); font-weight: 600; box-shadow: 0 2rpx 10rpx rgba(38, 57, 88, .08); }

.hero { padding: 30rpx 30rpx 26rpx; border-radius: 28rpx; background: linear-gradient(180deg, #eaf4ff 0%, #f7fbff 100%); }
.hero-title { font-size: 34rpx; font-weight: 700; }
.hero-copy { margin-top: 10rpx; color: #5c6b80; font-size: 24rpx; line-height: 1.6; }
.privacy-note { display: flex; gap: 12rpx; margin-top: 20rpx; padding-top: 18rpx; border-top: 1rpx solid rgba(0, 122, 255, .14); }
.privacy-mark { flex: none; height: 32rpx; padding: 0 12rpx; border-radius: 8rpx; background: var(--brand); color: #fff; font-size: 19rpx; line-height: 32rpx; }
.privacy-text { color: #5c6b80; font-size: 21rpx; line-height: 1.6; }

.form-card { margin-top: 24rpx; padding: 8rpx 26rpx 26rpx; border-radius: 28rpx; background: #fff; box-shadow: 0 6rpx 24rpx rgba(38, 57, 88, .05); }
.field { padding: 20rpx 0; border-bottom: 1rpx solid var(--line); }
.field:last-of-type { border-bottom: 0; }
.field-label { display: block; margin-bottom: 12rpx; color: var(--muted); font-size: 22rpx; }
.field-row { display: flex; align-items: center; gap: 16rpx; }
.field-action { flex: none; color: var(--brand); font-size: 23rpx; }
.field-input { box-sizing: border-box; width: 100%; height: 76rpx; padding: 0 18rpx; border-radius: 16rpx; background: #f8f9fb; font-size: 28rpx; }
.field-row .field-input { flex: 1; }
.mono { font-size: 21rpx; }
.placeholder { color: #b6bcc6; }

.picker-value { display: flex; align-items: center; justify-content: space-between; height: 76rpx; padding: 0 18rpx; border-radius: 16rpx; background: #f8f9fb; font-size: 26rpx; }
.field-hint { display: block; margin-top: 10rpx; color: var(--muted); font-size: 20rpx; }

.advanced-toggle { padding: 22rpx 0 6rpx; color: var(--brand); font-size: 23rpx; }
.advanced { padding-bottom: 10rpx; }
.advanced-hint { display: block; margin-top: 10rpx; color: var(--muted); font-size: 20rpx; line-height: 1.5; }

.import-button { margin-top: 26rpx; }

.error-card { margin-top: 24rpx; padding: 24rpx 26rpx; border-radius: 24rpx; background: #fff3f2; }
.error-title { color: #c0392b; font-size: 26rpx; font-weight: 700; }
.error-copy { margin-top: 10rpx; color: #8a4a42; font-size: 23rpx; line-height: 1.6; }
.error-copy.sub { margin-top: 12rpx; color: #9a6b63; font-size: 21rpx; }
.error-steps { margin-top: 14rpx; padding-top: 14rpx; border-top: 1rpx solid rgba(192, 57, 43, .16); }
.error-step { display: block; color: #8a4a42; font-size: 21rpx; line-height: 1.7; }
.diag-toggle { margin-top: 16rpx; color: #a8635a; font-size: 21rpx; text-decoration: underline; }
.diag-body { margin-top: 12rpx; padding: 16rpx; border-radius: 14rpx; background: rgba(0, 0, 0, .04); }
.diag-line { display: block; word-break: break-all; color: #6b4a45; font-size: 19rpx; line-height: 1.55; font-family: monospace; }

.preview-card { margin-top: 24rpx; padding: 24rpx 26rpx 26rpx; border-radius: 28rpx; background: #fff; box-shadow: 0 6rpx 24rpx rgba(38, 57, 88, .05); }
.preview-head { padding-bottom: 16rpx; border-bottom: 1rpx solid var(--line); }
.preview-title { font-size: 30rpx; font-weight: 700; }
.preview-sub { margin-top: 8rpx; color: var(--muted); font-size: 22rpx; }
.preview-list { height: 640rpx; margin-top: 8rpx; }
.preview-item { display: flex; gap: 16rpx; padding: 16rpx 0; border-bottom: 1rpx solid rgba(60, 60, 67, .08); }
.preview-item:last-child { border-bottom: 0; }
.preview-dot { flex: none; width: 10rpx; margin-top: 8rpx; border-radius: 6rpx; }
.preview-main { flex: 1; min-width: 0; }
.preview-name { font-size: 26rpx; font-weight: 600; }
.preview-meta { margin-top: 6rpx; color: #5c6b80; font-size: 21rpx; }
.preview-meta.light { color: var(--muted); }
.preview-more { padding: 16rpx 0 8rpx; color: var(--muted); font-size: 21rpx; text-align: center; }
.preview-actions { margin-top: 20rpx; display: flex; flex-direction: column; gap: 14rpx; }
.ghost-button { height: 84rpx; border-radius: 20rpx; background: transparent; color: var(--muted); font-size: 26rpx; }

.tips { margin-top: 26rpx; padding: 0 8rpx; }
.tips-title { margin-bottom: 10rpx; color: var(--muted); font-size: 21rpx; }
.tip { color: #8a939f; font-size: 21rpx; line-height: 1.9; }
