.tab-scroll { width: 100%; height: 100%; }
.tab-scroll .page-shell { min-height: 0; }

.profile-card { display: flex; align-items: center; gap: 22rpx; padding: 28rpx; border-radius: 26rpx; background: #fff; }
.profile-card:active { background: #fafafc; }
.profile-main { flex: 1; min-width: 0; }
.avatar { width: 92rpx; height: 92rpx; flex: none; display: block; border-radius: 26rpx; background: var(--brand-light); }
.profile-name { overflow: hidden; font-size: 34rpx; font-weight: 700; text-overflow: ellipsis; white-space: nowrap; }
.profile-copy { margin-top: 7rpx; color: var(--muted); font-size: 23rpx; }

.stats { display: flex; margin-top: 18rpx; padding: 22rpx 0; border-radius: 24rpx; background: #fff; }
.stats > view { flex: 1; border-right: 1rpx solid var(--line); text-align: center; }
.stats > view:last-child { border-right: 0; }
.stats text, .stats label { display: block; }
.stats text { font-size: 34rpx; font-weight: 700; }
.stats label { margin-top: 3rpx; color: var(--muted); font-size: 21rpx; }

.danger-row .row-title { color: var(--danger); }
.privacy { padding: 24rpx 12rpx; color: var(--muted); font-size: 22rpx; line-height: 1.55; }

.mask { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 200; display: flex; align-items: flex-end; background: rgba(13, 19, 29, .48); }
.sheet { width: 100%; box-sizing: border-box; padding: 32rpx 28rpx calc(34rpx + env(safe-area-inset-bottom)); border-radius: 34rpx 34rpx 0 0; background: #f7f7fa; }
.sheet-title { margin-bottom: 20rpx; font-size: 34rpx; font-weight: 700; }

.avatar-editor { display: flex; flex-direction: column; align-items: center; padding: 10rpx 0 28rpx; }
/* chooseAvatar 必须是 button，这里把尺寸锁死，避免被默认样式撑变形 */
.avatar-button { width: 152rpx; min-width: 152rpx; max-width: 152rpx; height: 152rpx; min-height: 152rpx; max-height: 152rpx; margin: 0; padding: 0; border-radius: 50%; background: transparent; line-height: 1; overflow: hidden; }
.avatar-button::after { border: 0; }
.avatar-preview { display: block; width: 152rpx; height: 152rpx; border-radius: 50%; background: var(--brand-light); }
.avatar-hint { margin-top: 16rpx; color: var(--brand); font-size: 23rpx; }

.editor-field { display: flex; align-items: center; gap: 20rpx; padding: 20rpx 24rpx; border-radius: 20rpx; background: #fff; }
.editor-label { flex: none; color: var(--muted); font-size: 24rpx; }
.editor-input { flex: 1; min-width: 0; height: 64rpx; font-size: 28rpx; }
.editor-save { margin-top: 26rpx; }
.editor-note { margin-top: 16rpx; color: var(--muted); font-size: 21rpx; text-align: center; }

/* 第二课堂累计自评 */
.second-card { margin-top: 20rpx; padding: 26rpx 24rpx; }
.second-top { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.second-num { flex: none; color: var(--brand); font-size: 40rpx; font-weight: 800; letter-spacing: -.5rpx; }
.second-full { color: #b3bac5; font-size: 22rpx; font-weight: 500; }
.second-bar { margin-top: 18rpx; height: 8rpx; border-radius: 999rpx; background: #eef1f6; overflow: hidden; }
.second-bar-fill { height: 100%; border-radius: 999rpx; background: linear-gradient(90deg, #4d9dff, #007aff); }
