<view class="page-shell">
  <view class="profile-card" bindtap="openEditor">
    <image class="avatar" src="{{profile.avatarUrl}}" mode="aspectFill" binderror="onAvatarError"></image>
    <view class="profile-main">
      <view class="profile-name">{{profile.nickName}}</view>
      <view class="profile-copy">北京化工大学</view>
    </view>
    <text class="chevron">›</text>
  </view>

  <view class="stats">
    <view><text>{{courseCount}}</text><label>课程</label></view>
    <view><text>{{noteCount}}</text><label>记事</label></view>
    <view><text>{{historyCount}}</text><label>对话</label></view>
  </view>

  <view class="section-title">通用</view>
  <view class="card">
    <view class="row" bindtap="openSecondClass">
      <view class="row-main"><view class="row-title">第二课堂</view><view class="row-copy">志愿公益、劳动教育等活动的学分记录</view></view>
      <text class="chevron">›</text>
    </view>
    <view class="row" bindtap="openEditor">
      <view class="row-main"><view class="row-title">头像与昵称</view><view class="row-copy">修改头像和昵称，只保存在本机</view></view>
      <text class="chevron">›</text>
    </view>
    <view class="row" bindtap="openSettings">
      <view class="row-main"><view class="row-title">课表设置</view><view class="row-copy">学期、周数与节次时间</view></view>
      <text class="chevron">›</text>
    </view>
    <view class="row" bindtap="showAbout">
      <view class="row-main"><view class="row-title">关于百小鸮</view><view class="row-copy">小程序能力说明与隐私边界</view></view>
      <text class="chevron">›</text>
    </view>
  </view>

  <view class="section-title">本机数据</view>
  <view class="card">
    <view class="row danger-row" bindtap="clearMiniData">
      <view class="row-main"><view class="row-title">删除记事与对话历史</view><view class="row-copy">不影响课表和课表设置</view></view>
    </view>
  </view>

  <view class="privacy">课表、记事、头像昵称和小鸮历史都保存在微信本地存储。当前小程序版没有接入账号云同步，也不会读取或保存教务系统密码。</view>
</view>

<view wx:if="{{editing}}" class="mask" bindtap="closeEditor">
  <view class="sheet" catchtap="noop">
    <view class="sheet-title">编辑资料</view>

    <view class="avatar-editor">
      <button class="avatar-button" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
        <image class="avatar-preview" src="{{draft.avatarUrl}}" mode="aspectFill"></image>
      </button>
      <view class="avatar-hint">点击更换头像</view>
    </view>

    <view class="editor-field">
      <text class="editor-label">昵称</text>
      <input class="editor-input" type="nickname" value="{{draft.nickName}}" placeholder="输入昵称" maxlength="20" bindinput="onNicknameInput" bindblur="onNicknameInput" />
    </view>

    <button class="primary-button editor-save" bindtap="saveProfileEdits">保存</button>
    <view class="editor-note">头像和昵称只写在本机缓存，不上传服务器。</view>
  </view>
</view>
