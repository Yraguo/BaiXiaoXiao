/* 自定义底部导航：原生 tabBar 的选中态是瞬间跳变，做不出滑动。
   这里把选中高亮做成一块会平移的胶囊，图标用灰/蓝两套叠加淡入。 */

.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  background: #ffffff;
  border-top: 0.5px solid rgba(0, 0, 0, .06);
  padding-bottom: env(safe-area-inset-bottom);
}

.tabbar-inner {
  position: relative;
  display: flex;
  height: 104rpx;
}

.tab-pill {
  position: absolute;
  top: 14rpx;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 20%;
  height: 76rpx;
  pointer-events: none;
  /* 与页面滑入用同一组时长和曲线，动作节奏一致才不显得两截 */
  transition: transform .36s cubic-bezier(.32, .72, .18, 1);
}

.tab-pill-body {
  width: 104rpx;
  height: 76rpx;
  border-radius: 24rpx;
  background: #eaf2ff;
}

.tab-item {
  position: relative;
  z-index: 1;
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
}

.tab-icon-wrap {
  position: relative;
  width: 44rpx;
  height: 44rpx;
}

.tab-icon {
  position: absolute;
  top: 0;
  left: 0;
  width: 44rpx;
  height: 44rpx;
}

.tab-icon-active {
  opacity: 0;
  transition: opacity .24s ease;
}

.tab-item.is-active .tab-icon-active { opacity: 1; }

.tab-text {
  font-size: 20rpx;
  line-height: 1;
  color: #8e8e93;
  transition: color .24s ease;
}

.tab-item.is-active .tab-text {
  color: #007aff;
  font-weight: 500;
}
