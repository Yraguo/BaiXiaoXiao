.profile-card { display: flex; align-items: center; gap: 22rpx; padding: 28rpx; border-radius: 26rpx; background: #fff; }.avatar { width: 92rpx; height: 92rpx; flex: none; display: block; border-radius: 26rpx; background: var(--brand-light); }.profile-name { font-size: 34rpx; font-weight: 700; }.profile-copy { margin-top: 7rpx; color: var(--muted); font-size: 23rpx; }.stats { display: flex; margin-top: 18rpx; padding: 22rpx 0; border-radius: 24rpx; background: #fff; }.stats > view { flex: 1; border-right: 1rpx solid var(--line); text-align: center; }.stats > view:last-child { border-right: 0; }.stats text, .stats label { display: block; }.stats text { font-size: 34rpx; font-weight: 700; }.stats label { margin-top: 3rpx; color: var(--muted); font-size: 21rpx; }.danger-row .row-title { color: var(--danger); }.privacy { padding: 24rpx 12rpx; color: var(--muted); font-size: 22rpx; line-height: 1.55; }
