<view class="uni-page">
  <view class="uni-head">
    <view class="uni-brand">
      <image class="brand-logo" src="/assets/logo.png" mode="aspectFill"></image>
      <view class="brand-text">
        <text class="brand-name">小鸮</text>
        <text class="uni-copy">本机校园助手</text>
      </view>
    </view>
    <view class="history-button" bindtap="showHistory" aria-role="button" aria-label="历史记录">历史</view>
  </view>

  <scroll-view class="messages" scroll-y scroll-top="{{scrollTop}}" scroll-with-animation>
    <view wx:if="{{!messages.length}}" class="welcome">
      <image class="welcome-logo" src="/assets/owl/owl-hello.png" mode="aspectFit"></image>
      <view class="welcome-title">你好，我是小鸮</view>
      <view class="welcome-copy">课表、记事、校园服务，都可以问我</view>
      <view class="suggestions">
        <view
          wx:for="{{suggestions}}"
          wx:key="*this"
          class="chip"
          data-text="{{item}}"
          bindtap="useSuggestion"
        >{{item}}</view>
      </view>
    </view>

    <view wx:for="{{messages}}" wx:key="id" class="message {{item.role}}">
      <image wx:if="{{item.role === 'assistant'}}" class="msg-avatar" src="{{item.avatar || '/assets/owl/owl-think.png'}}" mode="aspectFit"></image>
      <view class="bubble">{{item.text}}</view>
    </view>
  </scroll-view>

  <view wx:if="{{keyboardHint}}" class="voice-hint">{{keyboardHint}}</view>

  <view class="composer">
    <view class="composer-icon" bindtap="openKeyboardVoice" aria-role="button" aria-label="语音输入">⌁</view>
    <view class="composer-field">
      <input
        class="composer-input"
        value="{{text}}"
        bindinput="updateText"
        bindfocus="openKeyboardVoice"
        confirm-type="send"
        bindconfirm="send"
        placeholder="和小鸮说点什么…"
        placeholder-class="composer-placeholder"
      />
    </view>
    <view class="send {{text ? 'ready' : ''}}" bindtap="send" aria-role="button" aria-label="发送">发送</view>
  </view>
</view>

<view wx:if="{{historyOpen}}" class="mask" bindtap="hideHistory">
  <view class="history-sheet" catchtap="noop">
    <view class="sheet-head"><text>历史记录</text><text class="close" bindtap="hideHistory">完成</text></view>
    <scroll-view class="history-list" scroll-y>
      <view wx:if="{{!messages.length}}" class="history-empty">
        <image class="history-owl" src="/assets/owl/owl-sleep.png" mode="aspectFit"></image>
        <view>暂无历史记录</view>
      </view>
      <view wx:for="{{messages}}" wx:key="id" class="history-row">
        <text class="history-role">{{item.role === 'user' ? '你' : '小鸮'}}</text>
        <view class="history-text">{{item.text}}</view>
      </view>
    </scroll-view>
    <view wx:if="{{messages.length}}" class="history-clear" bindtap="clearHistory">清空历史记录</view>
  </view>
</view>
