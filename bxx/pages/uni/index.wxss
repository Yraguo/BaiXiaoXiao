.uni-page { height: calc(100vh - env(safe-area-inset-bottom)); display: flex; flex-direction: column; background: #f2f2f7; }
.uni-head { display: flex; align-items: center; justify-content: space-between; padding: 24rpx 28rpx 16rpx; }
.uni-brand { display: flex; align-items: center; gap: 10rpx; font-size: 38rpx; font-weight: 700; }.brand-logo { width: 46rpx; height: 46rpx; flex: none; display: block; border-radius: 12rpx; }.star { color: var(--brand); }.uni-copy { margin-top: 3rpx; color: var(--muted); font-size: 22rpx; }
.history-button { margin: 0; padding: 0 24rpx; border-radius: 18rpx; background: #fff; color: var(--brand); font-size: 25rpx; }
.messages { flex: 1; min-height: 0; padding: 10rpx 24rpx 30rpx; }
.welcome { margin: 120rpx 32rpx 0; text-align: center; }.welcome-logo { width: 136rpx; height: 136rpx; margin: 0 auto 22rpx; display: block; border-radius: 34rpx; }.welcome-title { font-size: 34rpx; font-weight: 700; }.welcome-copy { margin-top: 12rpx; color: var(--muted); font-size: 24rpx; }
.message { display: flex; margin: 18rpx 0; }.message.user { justify-content: flex-end; }.bubble { max-width: 76%; padding: 18rpx 22rpx; border-radius: 22rpx; background: #fff; line-height: 1.5; }.user .bubble { background: var(--brand); color: #fff; }
.voice-hint { margin: 0 24rpx 10rpx; padding: 14rpx 18rpx; border-radius: 16rpx; background: #fff7e6; color: #8a5a00; font-size: 22rpx; }
.composer { display: flex; align-items: center; gap: 12rpx; padding: 16rpx 20rpx calc(16rpx + env(safe-area-inset-bottom)); background: rgba(255,255,255,.94); border-top: 1rpx solid var(--line); }
.composer input { flex: 1; min-width: 0; height: 76rpx; padding: 0 20rpx; border-radius: 22rpx; background: #f2f2f7; }
.voice, .send { margin: 0; padding: 0; }.voice { width: 68rpx; height: 68rpx; border-radius: 50%; background: var(--brand-light); color: var(--brand); line-height: 68rpx; }.send { width: 100rpx; height: 68rpx; border-radius: 20rpx; background: var(--brand); color: #fff; font-size: 25rpx; line-height: 68rpx; }.send[disabled] { opacity: .45; }
.mask { position: fixed; inset: 0; z-index: 90; display: flex; align-items: flex-end; background: rgba(0,0,0,.38); }.history-sheet { width: 100%; max-height: 78vh; padding: 28rpx 24rpx calc(28rpx + env(safe-area-inset-bottom)); border-radius: 32rpx 32rpx 0 0; background: #f2f2f7; }.sheet-head { display: flex; justify-content: space-between; padding: 4rpx 6rpx 22rpx; font-size: 34rpx; font-weight: 700; }.close { color: var(--brand); font-size: 26rpx; font-weight: 500; }.history-list { max-height: 52vh; border-radius: 22rpx; background: #fff; }.history-row { display: flex; gap: 20rpx; padding: 20rpx 22rpx; border-bottom: 1rpx solid var(--line); }.history-row > text { width: 58rpx; flex: none; color: var(--brand); }.history-row > view { line-height: 1.45; }.clear { margin-top: 20rpx; border-radius: 20rpx; background: #fff; color: var(--danger); font-size: 27rpx; }
