.form-page { padding: 24rpx 24rpx 50rpx; }
.form-card { margin-bottom: 28rpx; padding: 10rpx 24rpx 4rpx; border-radius: 26rpx; background: #fff; box-shadow: 0 6rpx 24rpx rgba(38, 57, 88, .05); }
.field { padding: 20rpx 0 24rpx; border-bottom: 1rpx solid var(--line); }
.last-field { border-bottom: 0; }
.label { display: block; margin-bottom: 12rpx; color: var(--muted); font-size: 23rpx; }
input, textarea, .picker-value { box-sizing: border-box; width: 100%; min-height: 76rpx; padding: 17rpx 20rpx; border: 1rpx solid var(--line); border-radius: 16rpx; background: #f8f9fb; font-size: 27rpx; }
textarea { min-height: 110rpx; }
.picker-value { display: flex; justify-content: space-between; }
.picker-value text { color: var(--muted); }
.two-column { display: grid; grid-template-columns: 1fr 1fr; column-gap: 20rpx; }
.label-row { display: flex; justify-content: space-between; align-items: center; }
.label-row > view { display: flex; gap: 28rpx; color: var(--brand); font-size: 23rpx; }
.week-grid { display: grid; grid-template-columns: repeat(6, 1fr); gap: 14rpx; }
.week-pill { height: 62rpx; border: 1rpx solid var(--line); border-radius: 15rpx; background: #f8f9fb; font-size: 23rpx; line-height: 62rpx; text-align: center; }
.week-pill.selected { border-color: var(--brand); background: var(--brand-light); color: var(--brand); font-weight: 700; }
.color-grid { display: flex; flex-wrap: wrap; gap: 20rpx; }
.color-dot { width: 52rpx; height: 52rpx; box-sizing: border-box; border: 5rpx solid transparent; border-radius: 16rpx; }
.color-dot.selected { border-color: #17202e; box-shadow: inset 0 0 0 3rpx #fff; }
.delete-button { margin-top: 18rpx; }

