.form-card { padding: 0 24rpx; }
.field { padding: 24rpx 0; border-bottom: 1rpx solid var(--line); }
.field:last-child { border-bottom: 0; }
.field > text { display: block; margin-bottom: 14rpx; color: var(--muted); font-size: 23rpx; }
input, textarea { width: 100%; min-height: 72rpx; padding: 16rpx 18rpx; border-radius: 16rpx; background: #f7f7f9; font-size: 28rpx; }
textarea { min-height: 180rpx; }
.footnote { padding: 20rpx 12rpx; color: var(--muted); font-size: 22rpx; line-height: 1.5; }
