page {
  /* 品牌与语义色 */
  --brand: #007aff;
  --brand-light: #eaf4ff;
  --background: #f2f2f7;
  --card: #ffffff;
  --text: #111114;
  --muted: #8e8e93;
  --line: rgba(60, 60, 67, .14);
  --danger: #ff3b30;

  /*
   * 界面缩放系数：「我的 → 字号」会把它改成 1.08 / 1.16。
   * 所有字号都写成 calc(Nrpx * var(--fs, 1))，默认 1 时与原来完全一致。
   */
  --fs: 1;

  /*
   * 中性色阶（脚本生成）：左边是原来的硬编码值，所以浅色下的视觉零变化；
   * 暗色只在下面的 @media 里换值，业务样式一行都不用改。
   */
  --surface-1: #ffffff;
  --surface-2: #f8faff;
  --surface-3: #fafafc;
  --surface-4: #f8f9fc;
  --surface-5: #f7f9fc;
  --surface-6: #f8f9fb;
  --surface-7: #f8f8fa;
  --surface-8: #fff3f2;
  --surface-9: #f2f6ff;
  --surface-10: #f7f7fa;
  --surface-11: #f7f7f9;
  --surface-12: #f5f7fa;
  --surface-13: #fff0ef;
  --surface-14: #f4f6fa;
  --surface-15: #eef4ff;
  --surface-16: #f2f4f8;
  --surface-17: #f2f2f7;
  --surface-18: #eaf2ff;
  --surface-19: #f1f3f7;
  --surface-20: #fff8e8;
  --surface-21: #eef2f8;
  --surface-22: #eef2f7;
  --surface-23: #edf1f7;
  --surface-24: #eef1f6;
  --surface-25: #e6effd;
  --surface-26: #e6ebf3;
  --surface-27: #e9ebf0;
  --surface-28: #e8ebf1;
  --surface-29: #dfe4ec;
  --surface-30: #c8d2e0;
  --ink-1: #c7c7cc;
  --ink-2: #b9c1cc;
  --ink-3: #b6bcc6;
  --ink-4: #b3bac5;
  --ink-5: #a5adba;
  --ink-6: #9aa2af;
  --ink-7: #8a939f;
  --ink-8: #8e8e93;
  --ink-9: #9a6b63;
  --ink-10: #6b7686;
  --ink-11: #55688a;
  --ink-12: #5c6b80;
  --ink-13: #5a6472;
  --ink-14: #6b4a45;
  --ink-15: #4a5464;
  --ink-16: #3c4657;
  --ink-17: #354052;

  min-height: 100%;
  background: var(--background);
  color: var(--text);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

/*
 * 深色模式：跟随系统，不需要用户在 App 里拨开关。
 * 前提是 app.json 里 "darkmode": true（wxss 的 prefers-color-scheme 才生效）。
 * 页底最暗 → 卡片次之 → 输入框/选中态最亮，靠这个层次把 iOS 的观感立住。
 */
@media (prefers-color-scheme: dark) {
  page {
    --background: #0f0f11;
    --card: #1c1c1e;
    --text: #f2f2f7;
    --muted: #9a9aa0;
    --line: rgba(255, 255, 255, .12);
    --brand-light: rgba(0, 122, 255, .18);
  --surface-1: #1c1c1e;
  --surface-2: #1e1e21;
  --surface-3: #212124;
  --surface-4: #242427;
  --surface-5: #27272b;
  --surface-6: #2a2a2e;
  --surface-7: #2d2d32;
  --surface-8: #303035;
  --surface-9: #33333a;
  --surface-10: #37373e;
  --surface-11: #3b3b42;
  --surface-12: #3f3f46;
  --surface-13: #43434a;
  --surface-14: #47474e;
  --surface-15: #47474e;
  --surface-16: #47474e;
  --surface-17: #47474e;
  --surface-18: #47474e;
  --surface-19: #47474e;
  --surface-20: #47474e;
  --surface-21: #47474e;
  --surface-22: #47474e;
  --surface-23: #47474e;
  --surface-24: #47474e;
  --surface-25: #47474e;
  --surface-26: #47474e;
  --surface-27: #47474e;
  --surface-28: #47474e;
  --surface-29: #47474e;
  --surface-30: #47474e;
  --ink-1: #8e8e93;
  --ink-2: #96969b;
  --ink-3: #9e9ea4;
  --ink-4: #a6a6ac;
  --ink-5: #aeaeb4;
  --ink-6: #b6b6bc;
  --ink-7: #bfbfc5;
  --ink-8: #c8c8cd;
  --ink-9: #d1d1d6;
  --ink-10: #d9d9de;
  --ink-11: #e1e1e6;
  --ink-12: #e9e9ee;
  --ink-13: #f1f1f5;
  --ink-14: #f1f1f5;
  --ink-15: #f1f1f5;
  --ink-16: #f1f1f5;
  --ink-17: #f1f1f5;
  }
}

button::after { border: 0; }

.safe-bottom { padding-bottom: env(safe-area-inset-bottom); }

/*
 * 三个主按钮类共享的底子。
 * text-align 必须显式写：<button> 自带居中，但这些类也被 <view> 复用
 * （项目踩过 button 在 flex 里宽度失控的坑，很多交互元素改成了 view），
 * view 没有默认居中，不写就会把「保存」贴在色块最左边，像没写完的控件。
 */
.primary-button,
.secondary-button,
.danger-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 84rpx;
  border-radius: 22rpx;
  font-size: calc(28rpx * var(--fs, 1));
  font-weight: 600;
  line-height: 1.3;
  text-align: center;
}

.primary-button { background: var(--brand); color: #fff; }
.secondary-button { background: var(--surface-23); color: var(--ink-17); }
.danger-button { background: var(--surface-13); color: var(--danger); }

.page-shell { min-height: 100vh; padding: 24rpx 24rpx calc(48rpx + env(safe-area-inset-bottom)); }
.page-title { margin: 8rpx 4rpx 22rpx; font-size: calc(44rpx * var(--fs, 1)); font-weight: 700; letter-spacing: -.5rpx; }
.page-subtitle { margin: -14rpx 4rpx 24rpx; color: var(--muted); font-size: calc(24rpx * var(--fs, 1)); }
.card { overflow: hidden; border-radius: 24rpx; background: var(--card); }
.section-title { margin: 30rpx 12rpx 12rpx; color: var(--muted); font-size: calc(23rpx * var(--fs, 1)); }
.row { min-height: 104rpx; display: flex; align-items: center; padding: 18rpx 24rpx; border-bottom: 1rpx solid var(--line); }
.row:last-child { border-bottom: 0; }
.row-main { flex: 1; min-width: 0; }
.row-title { font-size: calc(29rpx * var(--fs, 1)); }
.row-copy { margin-top: 6rpx; color: var(--muted); font-size: calc(23rpx * var(--fs, 1)); line-height: 1.45; }
.chevron { color: var(--ink-1); font-size: calc(32rpx * var(--fs, 1)); }
.empty { padding: 96rpx 36rpx; color: var(--muted); text-align: center; }
.empty-mark { margin-bottom: 18rpx; color: var(--brand); font-size: calc(58rpx * var(--fs, 1)); }
